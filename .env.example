# SlimCoach — variables d’environnement (copiez ce fichier, adaptez, puis exportez-les
# dans votre hébergeur ou chargez-les avec : node --env-file=.env server.js)

# --- Général ---
PORT=3000
# NODE_ENV=production désactive les comptes de démonstration et le déblocage de test,
# et active les cookies "Secure" (HTTPS obligatoire).
NODE_ENV=development
APP_TIMEZONE=Africa/Lubumbashi
# Emplacement de la base SQLite (sauvegardez ce fichier régulièrement !)
# DB_PATH=./data/slimcoach.db

# --- Administrateur (créé au premier démarrage s’il n’existe aucun admin) ---
# En production, définissez ces deux valeurs, ou utilisez : npm run create-admin
# ADMIN_EMAIL=vous@exemple.com
# ADMIN_PASSWORD=un-mot-de-passe-long-et-unique

# --- Hébergement derrière un proxy (Nginx, Render, Railway, etc.) ---
# TRUST_PROXY=1
# COOKIE_SECURE=1

# --- Démo / test ---
# SEED_DEMO=1          : crée le compte de démonstration (par défaut : 1 hors production)
# DEV_TEST_UNLOCK=1    : affiche un bouton "Premium (test)" SANS paiement (par défaut : 1 hors production)

# --- Premium ---
# Prix indicatif affiché (à définir par l’éditeur ; aucun paiement n’est encaissé tant
# qu’un prestataire n’est pas intégré, voir README).
PREMIUM_PRICE_USD=9.99
# PAYMENT_PROVIDER=    : réservé à l’intégration future (voir lib/payment.js)
